# @shopify/hydrogen 2026.4.x declares a peer of @react-router/dev ~7.16, but
# this project runs @react-router/dev ^7.18. The combo works (build/typecheck/
# codegen are green), but strict peer resolution used by `npm ci` in the Oxygen
# deploy workflow rejects it. Accept the resolution so CI matches local installs.
legacy-peer-deps=true
