# Copy this file to `.env` and fill in values from:
# Shopify admin → Hydrogen → Storefront settings → Environments and variables.
# On Oxygen these variables are injected automatically; `.env` is for local dev only.
# `.env` is gitignored; this `.env.example` is safe to commit (no secrets).
SESSION_SECRET=""
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
