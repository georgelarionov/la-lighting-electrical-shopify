# Copy this file to `.env` and fill in values from:
# Shopify admin → Hydrogen → Storefront settings → Environments and variables.
# On Oxygen these variables are injected automatically; `.env` is for local dev only.
# `.env` is gitignored; this `.env.example` is safe to commit (no secrets).
SESSION_SECRET=""
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# Zoho CRM lead delivery (server-only secrets — see app/lib/zoho.ts).
# Data center hosts: US = accounts.zoho.com / www.zohoapis.com.
ZOHO_ACCOUNTS_HOST="https://accounts.zoho.com"
ZOHO_API_HOST="https://www.zohoapis.com"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
# Optional: Zoho user id that should own new leads (blank = API user owns them).
ZOHO_LEAD_OWNER_ID=""
# Optional: Lead_Source value — must already exist in the Zoho Leads picklist.
ZOHO_LEAD_SOURCE="Website Form"
